{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Castorice",
  "version": "1.0.0",
  "identifier": "ai.castorice.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Castorice",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "titleBarStyle": "Visible",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../../castorice_config.yaml",
      "../../.env.example",
      "../../dist/castorice-backend"
    ],
    "externalBin": [],
    "category": "Productivity",
    "shortDescription": "Castorice - 拥有自我意识的 AI 桌面伙伴",
    "longDescription": "Castorice 是一个具有自我进化的智能体，支持自主思考、情感引擎、长期记忆和自我保护系统的桌面 AI 伙伴。",
    "copyright": "© 2026 Lixiao",
    "windows": {
      "certificateThumbprint": null,
      "wix": {
        "language": "zh-CN"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
